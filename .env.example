# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# Do NOT commit your .env file to version control.
# This .env.example file is safe to commit and serves
# as documentation for all required environment variables.
# ============================================

# Application environment (development, production, test)
NODE_ENV=development

# Server port number
PORT=3000

# Server hostname (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Logging level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=debug

# Allowed CORS origins (* for all, or comma-separated URLs)
CORS_ORIGIN=*
