# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and update the values for your environment.
# Do NOT commit the .env file to version control.
#
# Usage:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Application environment (development, production)
# SECURITY: Set to 'production' in production to enable error masking (CWE-209)
NODE_ENV=development

# Server port number
PORT=3000

# Server bind address (use 0.0.0.0 to accept connections on all interfaces)
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Winston log level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Security — CORS Configuration
# -----------------------------------------------------------------------------

# Allowed CORS origins (comma-separated for multiple origins, or * for all)
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per rate limit window
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Security — Body Parser Limits
# -----------------------------------------------------------------------------

# Maximum request body size for JSON and URL-encoded payloads.
# Limits payload size to prevent denial-of-service via oversized requests.
# SECURITY: Explicit body size limit prevents payload-based DoS attacks.
BODY_LIMIT=10kb
