{
  "name": "hello_world",
  "version": "1.0.0",
  "description": "Express.js HTTP server with middleware, logging, and PM2 deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
