{
  "name": "hello_world",
  "version": "1.0.0",
  "description": "Production-ready Express.js web server with structured logging, security hardening, and PM2 deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "logs:pm2": "pm2 logs",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "nodemon": "^3.1.9",
    "pm2": "^6.0.14",
    "supertest": "^7.0.0"
  },
  "author": "hxu",
  "license": "MIT"
}
